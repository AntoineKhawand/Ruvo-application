rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Help Center FAQs
    match /help_categories/{categoryId} {
      allow read: if true; // Public read
      allow write: if false; 
    }

    // Users Collection
    match /users/{userId} {
      // 1. Any authenticated user can view any profile
      allow read: if request.auth != null;
      // 2. A user can only create/update/delete their own exact document
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Clubs Collection
    match /clubs/{clubId} {
      // 1. Any authenticated user can view any club
      allow read: if request.auth != null;
      // 2. Create requires auth, update/delete requires admin rights
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        request.auth.uid in resource.data.admins;
    }

    // Posts Collection
    match /posts/{postId} {
      // Anyone authenticated can read or create posts
      allow read, create: if request.auth != null;
      // Only the author can update or delete their post
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Chats Collection
    match /chats/{chatId} {
      // Participants can view and update chat details
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      // Creating a chat requires the creator to be in the participants list
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      // Prevent deleting whole chats directly for safety
      allow delete: if false;
    }

    // Chat Messages Collection
    match /chats/{chatId}/messages/{messageId} {
      // Participants of the parent chat can read and create messages
      allow read, create: if request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      // Only the sender can edit or delete their message (assuming userId or senderId field)
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.senderId);
    }

    // User Saved Routes Collection
    match /users/{userId}/saved_routes/{routeId} {
      // Only the owning user can view and manage their saved routes
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
