rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Help Center FAQs
    match /help_categories/{categoryId} {
      allow read: if true; // Public read
      allow write: if false; 
    }

    // Users Collection
    match /users/{userId} {
      // 1. Any authenticated user can view any profile
      allow read: if request.auth != null;
      // 2. A user can only create/update/delete their own exact document
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Clubs Collection
    match /clubs/{clubId} {
      // 1. Any authenticated user can view any club
      allow read: if request.auth != null;

      // 2. Any authenticated user can create a club (they become the creator)
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.createdBy;

      // 3. Update: admins can change anything; members can update membership fields only
      allow update: if request.auth != null && (
        // Admin/creator can do anything
        (request.auth.uid in resource.data.get('admins', [])) ||
        request.auth.uid == resource.data.createdBy ||
        // Any authenticated user can update only membership/request fields
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberCount', 'pendingRequests'])
      );

      // 4. Only creator or admins can delete
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in resource.data.get('admins', [])
      );

      match /posts/{postId} {
        // Any authenticated user can read club posts
        allow read: if request.auth != null;
        // Club members (or the creator) can create posts
        allow create: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.members ||
          request.auth.uid == get(/databases/$(database)/documents/clubs/$(clubId)).data.createdBy
        );
        // Allow author or admin to update (covers likes)
        allow update: if request.auth != null && (
          request.auth.uid == resource.data.userId ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
        );
        // Only the author or club creator can delete
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/clubs/$(clubId)).data.createdBy
        );
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if request.auth != null;
      // Only the author can create a post in their name
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // Allow the author to delete
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Allow the author to update everything, OR others to update ONLY likes/likedBy
      allow update: if request.auth != null && (
        // Author can update
        request.auth.uid == resource.data.userId || 
        // Others can only toggle their own like
        (
          request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'likedBy'])
        )
      );
    }

    // Chats Collection
    match /chats/{chatId} {
      // 1. Participants can view the chat details
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      
      // 2. Participants can update the chat (e.g., lastMessage), 
      //    BUT the 'users' array must remain exactly the same as before.
      allow update: if request.auth != null 
                    && request.auth.uid in resource.data.users
                    && request.resource.data.users == resource.data.users;

      // 3. Creating a chat requires the creator to be in the participants list
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
      
      // 4. Prevent deleting whole chats directly for safety
      allow delete: if false;
    }

    // Chat Messages Collection
    match /chats/{chatId}/messages/{messageId} {
      // Participants of the parent chat can read and create messages
      allow read: if request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      // Only the sender can edit or delete their message (assuming userId or senderId field)
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.senderId);
    }

    // User Saved Routes Collection
    match /users/{userId}/saved_routes/{routeId} {
      // Only the owning user can view and manage their saved routes
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User Notifications Subcollection
    match /users/{userId}/notifications/{notifId} {
      // Only the owning user can read, create, update, and delete their notifications
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User Audit Log Subcollection
    match /users/{userId}/auditLog/{logId} {
      // Only the owning user can write audit logs; read is restricted to admin
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if false; // Admin-only via Cloud Functions
    }

    // Rewards Collection (inventory read for RewardsScreen)
    match /rewards/{rewardId} {
      allow read: if request.auth != null;
      allow write: if false; // Write only via Cloud Functions (Admin SDK)
    }

    // Content Collection (Tips, Articles)
    match /content/{docId} {
      // Anyone authenticated can read tips
      allow read: if request.auth != null;
      // Write is restricted (admin via Cloud Functions or seeding)
      allow write: if false;
    }

    // Reports Collection
    match /reports/{reportId} {
      // Any authenticated user can file a report
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.reporterId;
      // Read/update/delete is admin-only (via Cloud Functions / Firebase Console)
      allow read, update, delete: if false;
    }
  }
}
