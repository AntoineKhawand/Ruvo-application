rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatars are publicly readable (shown on profiles/community screens to
    // any signed-in or anonymous viewer) but only the owning user can write
    // their own file, matched by exact filename ({uid}.jpg).
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }
  }
}
