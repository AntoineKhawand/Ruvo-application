rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny: access is granted per-path below, never bucket-wide.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Avatars: public read, owner-only write.
    // NOTE: Storage rules path variables match a whole segment, so the file name
    // is matched as a variable and compared against the owner's uid + extension.
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && (fileName == request.auth.uid + '.jpg' || fileName == request.auth.uid + '.png');
    }

    // Run photos: any signed-in user can view (community feed), owner-only write.
    match /runPhotos/{userId}/{photoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
