{
  "expo": {
    "name": "ruvo-application",
    "slug": "ruvo-application",
    "scheme": "ruvoapplication",
    "facebookScheme": "fb1107758504810502",
    "facebookAppId": "1107758504810502",
    "facebookClientToken": "0c30b1d5e28034655c0b7d6d956cc80e",
    "facebookDisplayName": "Ruvo",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/ruvo_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "location",
          "fetch"
        ]
      },
      "bundleIdentifier": "com.antoinekh.ruvoapplication"
    },
    "android": {
      "versionCode": 36,
      "blockedPermissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "notification": {
        "icon": "./assets/ruvo_icon.png",
        "color": "#000000",
        "iosDisplayInForeground": true
      },
      "package": "com.antoinekh.ruvoapplication",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBNHEvj4G7KCjHWsJfBbtELjfyah0x6iD4"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.WAKE_LOCK",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Ruvo to access your microphone."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Ruvo to track your run in the background when your screen is locked."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "extraProguardRules": "-dontwarn com.amazon.**"
          }
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      [
        "react-native-health",
        {
          "healthSharePermission": "Allow Ruvo to read health data to provide personalized coaching.",
          "healthUpdatePermission": "Allow Ruvo to update your health data with workout records."
        }
      ],
      "react-native-health-connect",
      "./withNetworkSecurityConfig.js",
      "expo-web-browser",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "6e633100-505f-4bad-9058-e5fa3082a025"
      }
    }
  }
}
